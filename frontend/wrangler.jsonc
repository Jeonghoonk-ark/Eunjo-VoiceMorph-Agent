{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eunjo-voicemorph",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "voicemorph.eunjo.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
